+    surfaceVariant = SurfaceHigh,
+    onSurfaceVariant = TextSecondaryDark,
+    surfaceContainer = SurfaceDark,
+    surfaceContainerHigh = SurfaceHigh,
+    surfaceContainerHighest = Color(0xFF2A2D33),
