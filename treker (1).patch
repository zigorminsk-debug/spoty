+                                Text(stringResource(R.string.search_history), style = MaterialTheme.typography.titleMedium, modifier = Modifier.weight(1f))
+                                TextButton(onClick = { viewModel.clearHistory() }) { Text(stringResource(R.string.clear)) }
+                            }
