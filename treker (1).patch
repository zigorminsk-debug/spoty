+package io.github.zigorminsk.spoty.data.local
+
+import androidx.room.Embedded
+import androidx.room.Entity
+import androidx.room.Index
+import androidx.room.PrimaryKey
+
+// ───────────── Каталог: всё, что приложение когда-либо нашло в источниках ─────────────
+
+@Entity(tableName = "artists", indices = [Index("source"), Index("searchKey")])
+data class ArtistEntity(
+    @PrimaryKey val id: String,
+    val source: String,
+    val name: String,
+    val searchKey: String,
+    val imageUrl: String?,
+    val coverUrl: String?,
+    val bio: String?,
+    val genre: String?,
+    val followers: Long,
+    val trackCount: Int,
+    val albumCount: Int,
+    val verified: Boolean,
+    val location: String?,
+    val webUrl: String?,
+    val discoveredAt: Long,
+    val updatedAt: Long,
+)
+
+@Entity(tableName = "albums", indices = [Index("artistId"), Index("source"), Index("searchKey")])
+data class AlbumEntity(
+    @PrimaryKey val id: String,
+    val source: String,
+    val title: String,
+    val searchKey: String,
+    val artistId: String?,
+    val artistName: String,
+    val artworkUrl: String?,
+    val year: Int?,
+    val genre: String?,
+    val trackCount: Int,
+    val durationMs: Long,
+    val kind: String,
+    val description: String?,
+    val playCount: Long,
+    val license: String?,
+    val webUrl: String?,
+    val discoveredAt: Long,
+    val updatedAt: Long,
+)
+
+@Entity(tableName = "tracks", indices = [Index("albumId"), Index("artistId"), Index("source"), Index("searchKey")])
+data class TrackEntity(
+    @PrimaryKey val id: String,
+    val source: String,
+    val title: String,
+    val searchKey: String,
+    val artistId: String?,
+    val artistName: String,
+    val albumId: String?,
+    val albumTitle: String?,
+    val trackNumber: Int,
+    val durationMs: Long,
+    val artworkUrl: String?,
+    val streamUrl: String,
+    val genre: String?,
+    val license: String?,
+    val playCount: Long,
+    val webUrl: String?,
+    val discoveredAt: Long,
+    val updatedAt: Long,
+)
+
+// ───────────── Данные пользователя ─────────────
+
+@Entity(tableName = "liked_tracks")
+data class LikedTrackEntity(@PrimaryKey val trackId: String, val likedAt: Long)
+
+@Entity(tableName = "disliked_tracks")
+data class DislikedTrackEntity(@PrimaryKey val trackId: String, val dislikedAt: Long)
+
